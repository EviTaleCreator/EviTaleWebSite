<header class="border-b border-[#E8E1D5] bg-[#FAF7F2]/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <!-- Logotipas -->
    <a href="/" class="group flex flex-col">
      <span class="font-cinzel text-2xl font-bold tracking-wider text-[#1D2520] group-hover:text-[#D96B43] transition-colors">EviTale</span>
      <span class="font-sans text-[10px] tracking-widest uppercase text-[#7A736E] -mt-1">Creator</span>
    </a>

    <!-- Navigacija -->
    <nav class="hidden md:flex items-center space-x-8 font-sans text-sm font-medium text-[#4A4540]">
      <a href="/lentyna" class="hover:text-[#1D2520] transition-colors">Lentyna</a>
      <a href="/apie-mane" class="hover:text-[#1D2520] transition-colors">Apie mane</a>
      <a href="/kontaktai" class="hover:text-[#1D2520] transition-colors">Kontaktai</a>
    </nav>

    <!-- Paieškos ar papildomas mygtukas -->
    <div class="flex items-center space-x-4">
      <a href="/lentyna" class="font-sans text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-[#DED7CB] hover:bg-[#1D2520] hover:text-[#FAF7F2] transition-all">
