---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LayerPicker from './LayerPicker.astro';
import { getStories, type Story } from '../lib/stories';
import { UI, homeUrl, storyUrl, formatDate, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  story: Story;
}

const { lang, story } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'lt' ? 'en' : 'lt';

const all = await getStories(lang);
const index = all.findIndex((s) => s.slug === story.slug);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

// Jei pasaka išversta, kalbos jungiklis veda į tą pačią pasaką, jei ne – į kitos kalbos lentyną.
const otherStories = await getStories(other);
const otherHref = otherStories.some((s) => s.slug === story.slug) ? storyUrl(other, story.slug) : homeUrl(other);

const rendered = await Promise.all(
  story.layers.map(async (l) => ({ id: l.id, Content: (await render(l.entry)).Content })),
);
---

<Base
  lang={lang}
  title={story.title}
  description={story.excerpt}
  back
  alternates={lang === 'lt' ? { lt: storyUrl('lt', story.slug), en: otherHref } : { lt: otherHref, en: storyUrl('en', story.slug) }}
>
  <main class="story">
    <div class="wrap narrow">
      {
        story.cover && (
          <figure class="story-cover">
            <Image src={story.cover} alt={story.coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 720px) 690px, 100vw" loading="eager" fetchpriority="high" />
          </figure>
        )
      }
      <div class="story-head">
        <span class="date">{formatDate(story.date, lang)}</span>
        <h1>{story.title}</h1>
      </div>
    </div>

    <div class="sticky-bar">
      <div class="wrap narrow bar-row">
        <div class="bar-picker">
          <LayerPicker lang={lang} layers={story.layers.map((l) => l.id)} selected={story.defaultLayer} caption={t.layer} id="story-picker" />
        </div>
        <div class="text-size" role="group" aria-label={t.textSize}>
          <button type="button" data-text-size="down" aria-label={t.textSmaller}>A−</button>
          <button type="button" data-text-size="up" aria-label={t.textBigger} class="bigger">A+</button>
        </div>
      </div>
    </div>

    <div class="wrap narrow" data-default-layer={story.defaultLayer}>
      {
        rendered.map(({ id, Content }) => (
          <section class={`layer layer-${id} l-${id}`} data-layer={id} hidden={id !== story.defaultLayer}>
            {
              story.sadEnding.includes(id) && (
                <p class="ending-note">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
                  </svg>
                  <span>
                    {t.sadEnding}
                    {story.layers.some((l) => l.id === 'giliau') && (
                      <>
                        {' '}
                        <button type="button" class="link-btn" data-goto-layer="giliau">{t.sadEndingLink}</button>
                      </>
                    )}
                  </span>
                </p>
              )
            }
            <div class="prose">
              <Content />
            </div>
          </section>
        ))
      }
    </div>

    <nav class="wrap narrow story-nav" aria-label={t.otherStories}>
      {
        older && (
          <a class="btn btn-light" href={storyUrl(lang, older.slug)} data-keep-layer>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {t.older}
          </a>
        )
      }
      {
        newer && (
          <a class="btn btn-dark" href={storyUrl(lang, newer.slug)} data-keep-layer>
            {t.newer}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
      {
        !older && !newer && (
          <a class="btn btn-dark" href={`${homeUrl(lang)}#lentyna`} data-keep-layer>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {t.toShelf}
          </a>
        )
      }
    </nav>
  </main>
</Base>

<script>
  import { initPicker, layerFromUrl, loadLayer, saveLayer, syncLayerEverywhere } from '../scripts/picker';

  const root = document.getElementById('story-picker');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-layer]'));
  const fallback = document.querySelector<HTMLElement>('[data-default-layer]')?.dataset.defaultLayer ?? '';

  function show(value: string) {
    sections.forEach((s) => (s.hidden = s.dataset.layer !== value));
    syncLayerEverywhere(value);
  }

  if (root) {
    const picker = initPicker(root, (value) => {
      saveLayer(value);
      show(value);
    });
    const pick = () => {
      const fromUrl = layerFromUrl();
      const wanted = [fromUrl, loadLayer()].find((v) => v && picker.values.includes(v));
      const value = wanted ?? fallback;
      picker.set(value);
      show(value);
    };
    pick();
    window.addEventListener('pageshow', pick);

    // Nuoroda iš įspėjimo apie pabaigą atidaro „Giliau“.
    document.querySelectorAll<HTMLButtonElement>('[data-goto-layer]').forEach((b) =>
      b.addEventListener('click', () => {
        const value = b.dataset.gotoLayer ?? '';
        if (!picker.set(value)) return;
        saveLayer(value);
        show(value);
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }),
    );
  }

  // Kol atidaryta pasaka, telefono ekranas neužgęsta (jei naršyklė tai leidžia).
  type WakeLockSentinelLike = { release: () => Promise<void> };
  let wakeLock: WakeLockSentinelLike | null = null;
  async function keepAwake() {
    const nav = navigator as Navigator & { wakeLock?: { request: (t: 'screen') => Promise<WakeLockSentinelLike> } };
    if (!nav.wakeLock || wakeLock || document.visibilityState !== 'visible') return;
    try {
      wakeLock = await nav.wakeLock.request('screen');
      (wakeLock as unknown as EventTarget).addEventListener?.('release', () => (wakeLock = null));
    } catch {
      wakeLock = null; // pvz., naršyklė prašo, kad žmogus pirmiau paliestų ekraną
    }
  }
  keepAwake();
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') keepAwake();
  });
  // Kai kurios naršyklės leidžia tik po prisilietimo: bandome dar kartą per pirmą sąveiką.
  ['pointerdown', 'keydown', 'scroll'].forEach((ev) => window.addEventListener(ev, keepAwake, { passive: true }));

  // Raidžių dydis: penki žingsniai, įsimenamas šiame įrenginyje.
  const SCALES = [0.85, 1, 1.15, 1.3, 1.5];
  const docEl = document.documentElement;
  const down = document.querySelector<HTMLButtonElement>('[data-text-size="down"]');
  const up = document.querySelector<HTMLButtonElement>('[data-text-size="up"]');

  function currentStep() {
    const v = parseFloat(getComputedStyle(docEl).getPropertyValue('--read-scale')) || 1;
    let best = 1;
    SCALES.forEach((s, i) => {
      if (Math.abs(s - v) < Math.abs(SCALES[best] - v)) best = i;
    });
    return best;
  }

  function setStep(i: number) {
    const step = Math.max(0, Math.min(SCALES.length - 1, i));
    docEl.style.setProperty('--read-scale', String(SCALES[step]));
    if (down) down.disabled = step === 0;
    if (up) up.disabled = step === SCALES.length - 1;
    try {
      localStorage.setItem('evitale-text', String(SCALES[step]));
    } catch {
      /* saugykla išjungta */
    }
  }

  const startStep = currentStep();
  if (down) down.disabled = startStep === 0;
  if (up) up.disabled = startStep === SCALES.length - 1;
  down?.addEventListener('click', () => setStep(currentStep() - 1));
  up?.addEventListener('click', () => setStep(currentStep() + 1));
</script>
