---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getStories, type Story } from '../lib/stories';
import { LAYERS, UI, storyUrl, formatDate } from '../lib/i18n';

interface Props {
  story: Story;
}

const { story } = Astro.props;

const all = await getStories();
const index = all.findIndex((s) => s.slug === story.slug);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const rendered = await Promise.all(story.layers.map(async (l) => ({ ...l, Content: (await render(l.entry)).Content })));
const share = await getImage({ src: story.cover, width: 1200, format: 'jpg' });
---

<Base title={story.title} description={story.excerpt} image={share.src}>
  <main class="story">
    <figure class="story-cover">
      <Image src={story.cover} alt={story.coverAlt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1000px, 100vw" loading="eager" fetchpriority="high" />
    </figure>

    <div class="narrow story-head">
      <span class="date">{formatDate(story.date)}</span>
      <h1>{story.title}</h1>
      {story.excerpt && <p class="excerpt">{story.excerpt}</p>}
    </div>

    <div class="read-bar">
      <div class="narrow bar-row">
        <div class="seg" role="group" aria-label={UI.whoFor} data-story-seg>
          {
            story.layers.map((l) => (
              <button type="button" data-value={l.id} aria-pressed={l.id === story.defaultLayer ? 'true' : 'false'}>
                {LAYERS[l.id].label}
                <small>{[LAYERS[l.id].age, `~${l.minutes} ${UI.minutes}`].filter(Boolean).join(' · ')}</small>
              </button>
            ))
          }
        </div>
        <div class="text-size" role="group" aria-label={UI.textSize}>
          <button type="button" data-text-size="down" aria-label={UI.textSmaller}>A−</button>
          <button type="button" data-text-size="up" aria-label={UI.textBigger} class="bigger">A+</button>
        </div>
      </div>
    </div>

    <div class="narrow" data-default-layer={story.defaultLayer}>
      {
        rendered.map(({ id, Content }) => (
          <section class={`layer layer-${id}`} data-layer={id} hidden={id !== story.defaultLayer}>
            {story.sadEnding.includes(id) && (
              <p class="ending-note">
                {UI.sadEnding}{' '}
                <button type="button" class="link-btn" data-open-talk>
                  {UI.sadEndingLink}
                </button>
              </p>
            )}
            <div class="prose">
              <Content />
            </div>
          </section>
        ))
      }
    </div>

    <nav class="narrow story-nav" aria-label="Kitos pasakos">
      {
        older ? (
          <a class="nav-btn" href={storyUrl(older.slug)} data-keep-layer>
            ← {older.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a class="nav-btn primary" href={storyUrl(newer.slug)} data-keep-layer>
            {newer.title} →
          </a>
        ) : (
          <a class="nav-btn primary" href="/#lentyna" data-keep-layer>
            {UI.toShelf} →
          </a>
        )
      }
    </nav>
  </main>
</Base>

<script>
  import { initSeg, layerFromUrl, loadLayer, saveLayer, syncLayerEverywhere } from '../scripts/picker';

  const root = document.querySelector<HTMLElement>('[data-story-seg]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-layer]'));
  const fallback = document.querySelector<HTMLElement>('[data-default-layer]')?.dataset.defaultLayer ?? '';

  function show(value: string) {
    sections.forEach((s) => (s.hidden = s.dataset.layer !== value));
    syncLayerEverywhere(value);
  }

  if (root) {
    const seg = initSeg(root, (value) => {
      saveLayer(value);
      show(value);
    });
    const pick = () => {
      const wanted = [layerFromUrl(), loadLayer()].find((v) => v && seg.values.includes(v));
      const value = wanted ?? fallback;
      seg.set(value);
      show(value);
    };
    pick();
    window.addEventListener('pageshow', pick);
  }

  // Nuoroda iš įspėjimo apie pabaigą atidaro „Pokalbiui“ to paties skaitymo gale.
  document.querySelectorAll<HTMLButtonElement>('[data-open-talk]').forEach((b) =>
    b.addEventListener('click', () => {
      const talk = b.closest('section')?.querySelector<HTMLDetailsElement>('details.talk');
      if (!talk) return;
      talk.open = true;
      talk.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  // Kol atidaryta pasaka, telefono ekranas neužgęsta (jei naršyklė tai leidžia).
  type WakeLockSentinelLike = { release: () => Promise<void> };
  let wakeLock: WakeLockSentinelLike | null = null;
  async function keepAwake() {
    const nav = navigator as Navigator & { wakeLock?: { request: (t: 'screen') => Promise<WakeLockSentinelLike> } };
    if (!nav.wakeLock || wakeLock || document.visibilityState !== 'visible') return;
    try {
      wakeLock = await nav.wakeLock.request('screen');
      (wakeLock as unknown as EventTarget).addEventListener?.('release', () => (wakeLock = null));
    } catch {
      wakeLock = null; // pvz., naršyklė prašo, kad žmogus pirmiau paliestų ekraną
    }
  }
  keepAwake();
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') keepAwake();
  });
  ['pointerdown', 'keydown', 'scroll'].forEach((ev) => window.addEventListener(ev, keepAwake, { passive: true }));

  // Raidžių dydis: penki žingsniai, įsimenamas šiame įrenginyje.
  const SCALES = [0.85, 1, 1.15, 1.3, 1.5];
  const docEl = document.documentElement;
  const down = document.querySelector<HTMLButtonElement>('[data-text-size="down"]');
  const up = document.querySelector<HTMLButtonElement>('[data-text-size="up"]');

  function currentStep() {
    const v = parseFloat(getComputedStyle(docEl).getPropertyValue('--read-scale')) || 1;
    let best = 1;
    SCALES.forEach((s, i) => {
      if (Math.abs(s - v) < Math.abs(SCALES[best] - v)) best = i;
    });
    return best;
  }

  function setStep(i: number) {
    const step = Math.max(0, Math.min(SCALES.length - 1, i));
    docEl.style.setProperty('--read-scale', String(SCALES[step]));
    if (down) down.disabled = step === 0;
    if (up) up.disabled = step === SCALES.length - 1;
    try {
      localStorage.setItem('evitale-text', String(SCALES[step]));
    } catch {
      /* saugykla išjungta */
    }
  }

  const startStep = currentStep();
  if (down) down.disabled = startStep === 0;
  if (up) up.disabled = startStep === SCALES.length - 1;
  down?.addEventListener('click', () => setStep(currentStep() - 1));
  up?.addEventListener('click', () => setStep(currentStep() + 1));
</script>
