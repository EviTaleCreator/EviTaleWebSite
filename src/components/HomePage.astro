---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LayerPicker from './LayerPicker.astro';
import hero from '../assets/hero.jpg';
import { getStories } from '../lib/stories';
import { LAYERS, LAYER_IDS, UI, EMAIL, formatDate, storyUrl, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const stories = await getStories(lang);
const latest = stories[0];
---

<Base lang={lang} title={t.homeTitle} alternates={{ lt: '/', en: '/en/' }}>
  <main>
    <section class="hero">
      <div class="wrap">
        <figure class="hero-media">
          <Image
            src={hero}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1000px) 600px, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <div class="hero-text">
          <p class="eyebrow">{t.eyebrow}</p>
          <h1>{t.heroTitle}</h1>
          <p class="hero-sub">{t.heroSub}</p>
          {
            latest && (
              <a class="latest" href={storyUrl(lang, latest.slug)} data-keep-layer>
                {latest.cover && <Image src={latest.cover} alt="" width={168} height={168} />}
                <span class="latest-text">
                  <span class="latest-kicker">{t.latest}</span>
                  <span class="latest-title">{latest.title}</span>
                  <span class="latest-cta">
                    {t.read}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="section shelf" id="lentyna" aria-labelledby="shelf-title">
      <div class="wrap section-head">
        <h2 id="shelf-title">{t.shelf}</h2>
        <span class="count" data-count data-forms={JSON.stringify(t.count)} data-lang={lang}></span>
      </div>
      <div class="sticky-bar">
        <div class="wrap">
          <div class="shelf-picker">
            <LayerPicker lang={lang} layers={[...LAYER_IDS]} withAll selected="all" caption={t.show} id="shelf-picker" />
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="cards">
          {
            stories.map((s) => (
              <a class="card" href={storyUrl(lang, s.slug)} data-card data-layers={s.layers.map((l) => l.id).join(' ')} data-keep-layer>
                {s.cover && (
                  <div class="card-media">
                    <Image src={s.cover} alt="" widths={[400, 700]} sizes="(min-width: 1000px) 360px, (min-width: 700px) 50vw, 100vw" />
                  </div>
                )}
                <div class="card-body">
                  <div class="pills">
                    {s.layers.map((l) => (
                      <span class={`pill l-${l.id}`}>{LAYERS[l.id].label[lang]}</span>
                    ))}
                  </div>
                  <h3>{s.title}</h3>
                  {s.excerpt && <p>{s.excerpt}</p>}
                  <div class="card-meta">
                    <span>{formatDate(s.date, lang)}</span>
                    <span class="go">{t.read} →</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <p class="empty" data-empty hidden={stories.length > 0}>{t.empty}</p>
      </div>
    </section>

    <section class="section" id="sluoksniai" aria-labelledby="layers-title">
      <div class="wrap">
        <h2 id="layers-title">{t.layersTitle}</h2>
        <p class="intro" style="margin-top: 10px">{t.layersIntro}</p>
        <ul class="layer-list">
          {
            LAYER_IDS.map((id) => (
              <li class={`l-${id}`}>
                <span class="name">{LAYERS[id].label[lang]}</span>
                <span class="about">{LAYERS[id].about[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section contact" id="kontaktai" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <a class="mail" href={`mailto:${EMAIL}`}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5" />
            <path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
          {EMAIL}
        </a>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initPicker, layerFromUrl, syncLayerEverywhere } from '../scripts/picker';

  const root = document.getElementById('shelf-picker');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');

  function countText(n: number) {
    const forms: string[] = JSON.parse(count?.dataset.forms ?? '[]');
    if (count?.dataset.lang === 'lt') {
      const lastTwo = n % 100;
      const last = n % 10;
      const form = last === 1 && lastTwo !== 11 ? forms[0] : last === 0 || (lastTwo >= 10 && lastTwo <= 20) ? forms[2] : forms[1];
      return `${n} ${form}`;
    }
    return `${n} ${n === 1 ? forms[0] : forms[1]}`;
  }

  function applyFilter(value: string) {
    let visible = 0;
    cards.forEach((card) => {
      const show = value === 'all' || (card.dataset.layers ?? '').split(' ').includes(value);
      card.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = countText(visible);
    syncLayerEverywhere(value);
  }

  if (root) {
    const picker = initPicker(root, applyFilter);
    const fromUrl = layerFromUrl();
    const start = fromUrl && picker.values.includes(fromUrl) ? fromUrl : 'all';
    picker.set(start);
    applyFilter(start);
    window.addEventListener('pageshow', () => {
      const v = layerFromUrl() ?? 'all';
      if (picker.set(v)) applyFilter(v);
    });
  }
</script>
