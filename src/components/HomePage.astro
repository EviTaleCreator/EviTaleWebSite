---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getStories } from '../lib/stories';
import { LAYERS, UI, EMAIL, formatDate, storyUrl, countText } from '../lib/i18n';

const stories = await getStories();
const latest = stories[0];
const latestLayer = latest?.layers[0];
const share = latest ? await getImage({ src: latest.cover, width: 1200, format: 'jpg' }) : undefined;
---

<Base title={UI.homeTitle} image={share?.src}>
  <main>
    {
      latest && latestLayer && (
        <section class="wrap hero" aria-labelledby="hero-title">
          <div class="hero-text">
            <div class="story-name">
              <h1>
                <a id="hero-title" href={storyUrl(latest.slug)}>{latest.title}</a>
              </h1>
              <span>
                {UI.latest} · {formatDate(latest.date)}
              </span>
              {latest.upcoming && <span class="upcoming">Dar nepaskelbta · matoma tik čia, localhost</span>}
            </div>

            <div class="sentence">
              <p>{latestLayer.firstParagraph}</p>
              <p class="meta">
                <span>~{latestLayer.minutes} {UI.minutes}</span>
                <span>{LAYERS[latestLayer.id].mood}</span>
              </p>
            </div>

            <div class="actions">
              <a class="btn" href={storyUrl(latest.slug)}>
                {UI.readOn}
              </a>
              <a class="text-link" href="#lentyna">
                {UI.allStories}
              </a>
            </div>
          </div>

          <a class="hero-art" href={storyUrl(latest.slug)} tabindex="-1" aria-hidden="true">
            <Image src={latest.cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 42vw, 100vw" loading="eager" fetchpriority="high" />
          </a>
        </section>
      )
    }

    <section class="shelf" id="lentyna" aria-labelledby="shelf-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="shelf-title">
            {UI.shelf} <span class="count">{countText(stories.length)}</span>
          </h2>
        </div>

        <div class="books">
          {
            stories.map((s, i) => (
              <a class="book" href={storyUrl(s.slug)}>
                <div class="book-cover">
                  <Image src={s.cover} alt="" widths={[400, 700]} sizes="(min-width: 1000px) 380px, (min-width: 700px) 50vw, 100vw" />
                  {i === 0 && <span class="tag">Nauja</span>}
                </div>
                <h3>{s.title}</h3>
                {s.excerpt && <p>{s.excerpt}</p>}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about" id="apie" aria-labelledby="about-title">
      <div class="wrap about-grid">
        <div>
          <h2 id="about-title">{UI.aboutTitle}</h2>
          {UI.aboutText.map((p) => <p>{p}</p>)}
        </div>
        <div class="contact" id="kontaktai">
          <h2>{UI.contactTitle}</h2>
          <p>{UI.contactText}</p>
          <div class="mail-row">
            <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <button type="button" class="copy-btn" data-copy={EMAIL} aria-label="Kopijuoti el. pašto adresą" title="Kopijuoti adresą">
              <svg class="icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
              </svg>
              <svg class="icon-done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7"></path>
              </svg>
            </button>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </div>
          <p class="copy-hint">* Jei pašto programa neatsidaro, nukopijuokite adresą.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // El. pašto adreso kopijavimas: ne visuose kompiuteriuose mailto nuoroda atidaro pašto programą.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'absolute';
        area.style.left = '-9999px';
        document.body.appendChild(area);
        area.select();
        ok = document.execCommand('copy');
        area.remove();
      }
      if (status) status.textContent = ok ? 'Adresas nukopijuotas' : 'Nepavyko nukopijuoti, pažymėkite adresą';
      if (ok) {
        btn.classList.add('done');
        btn.title = 'Nukopijuota';
        window.setTimeout(() => {
          btn.classList.remove('done');
          btn.title = 'Kopijuoti adresą';
          if (status) status.textContent = '';
        }, 2000);
      }
    });
  });
</script>
