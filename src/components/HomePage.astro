---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LayerPicker from './LayerPicker.astro';
import hero from '../assets/hero.jpg';
import { getStories } from '../lib/stories';
import { LAYERS, LAYER_IDS, UI, EMAIL, formatDate, storyUrl, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const stories = await getStories(lang);
const latest = stories[0];
---

<Base lang={lang} title={t.homeTitle} alternates={{ lt: '/', en: '/en/' }}>
  <main>
    <section class="hero">
      <figure class="hero-media">
        <Image
          src={hero}
          alt=""
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="wrap hero-text">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.heroTitle}</h1>
        <p class="hero-sub">{t.heroSub}</p>
        {
          latest && (
            <a class="cta" href={storyUrl(lang, latest.slug)} data-keep-layer>
              {t.latestCta}
            </a>
          )
        }
      </div>
    </section>

    <section class="section shelf" id="lentyna" aria-labelledby="shelf-title">
      <div class="wrap section-head">
        <h2 id="shelf-title">{t.shelf}</h2>
        <span class="count" data-count data-forms={JSON.stringify(t.count)} data-lang={lang}></span>
      </div>
      <div class="sticky-bar">
        <div class="wrap">
          <div class="shelf-picker">
            <LayerPicker lang={lang} layers={[...LAYER_IDS]} withAll selected="all" caption={t.show} id="shelf-picker" />
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="cards">
          {
            stories.map((s) => (
              <a class="card" href={storyUrl(lang, s.slug)} data-card data-layers={s.layers.map((l) => l.id).join(' ')} data-keep-layer>
                {s.cover && (
                  <div class="card-media">
                    <Image src={s.cover} alt="" widths={[400, 700]} sizes="(min-width: 1000px) 360px, (min-width: 700px) 50vw, 100vw" />
                  </div>
                )}
                <div class="card-body">
                  <div class="pills">
                    {s.layers.map((l) => (
                      <span class={`pill l-${l.id}`}>{LAYERS[l.id].label[lang]}</span>
                    ))}
                  </div>
                  <h3>{s.title}</h3>
                  {s.excerpt && <p>{s.excerpt}</p>}
                  <div class="card-meta">
                    <span>{formatDate(s.date, lang)}</span>
                    <span class="go">{t.read} →</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <p class="empty" data-empty hidden={stories.length > 0}>{t.empty}</p>
      </div>
    </section>

    <section class="section" id="sluoksniai" aria-labelledby="layers-title">
      <div class="wrap">
        <h2 id="layers-title">{t.layersTitle}</h2>
        <p class="intro" style="margin-top: 10px">{t.layersIntro}</p>
        <ul class="layer-list">
          {
            LAYER_IDS.map((id) => (
              <li class={`l-${id}`}>
                <span class="name">{LAYERS[id].label[lang]}</span>
                <span class="about">{LAYERS[id].about[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section contact" id="kontaktai" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initPicker, layerFromUrl, loadLayer, saveLayer, syncLayerEverywhere } from '../scripts/picker';

  const root = document.getElementById('shelf-picker');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');

  function countText(n: number) {
    const forms: string[] = JSON.parse(count?.dataset.forms ?? '[]');
    if (count?.dataset.lang === 'lt') {
      const lastTwo = n % 100;
      const last = n % 10;
      const form = last === 1 && lastTwo !== 11 ? forms[0] : last === 0 || (lastTwo >= 10 && lastTwo <= 20) ? forms[2] : forms[1];
      return `${n} ${form}`;
    }
    return `${n} ${n === 1 ? forms[0] : forms[1]}`;
  }

  function applyFilter(value: string) {
    let visible = 0;
    cards.forEach((card) => {
      const show = value === 'all' || (card.dataset.layers ?? '').split(' ').includes(value);
      card.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = countText(visible);
    syncLayerEverywhere(value);
  }

  if (root) {
    const picker = initPicker(root, (value) => {
      saveLayer(value);
      applyFilter(value);
    });
    // Pirmiausia adresas, tada įsimintas sluoksnis, kitaip „Visi“.
    const startValue = () => [layerFromUrl(), loadLayer()].find((v) => v && picker.values.includes(v)) ?? 'all';
    const start = startValue();
    picker.set(start);
    applyFilter(start);
    window.addEventListener('pageshow', () => {
      const v = startValue();
      if (picker.set(v)) applyFilter(v);
    });
  }
</script>
