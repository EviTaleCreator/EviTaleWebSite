---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Virtualios rašytojos EviTale pasakos su psichologiniu sluoksniu" } = Astro.props;
---

<!doctype html>
<html lang="lt" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | EviTale Creator</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#FAF7F2] text-[#2C2825] font-serif text-lg leading-relaxed antialiased selection:bg-[#D96B43]/20 min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-grow">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
