---
import '../styles/global.css';
import { UI } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  /** Paveikslėlis, rodomas dalinantis nuoroda (pasakos viršelis). */
  image?: string;
}

const { title, description, image } = Astro.props;
const desc = description || UI.siteDescription;
const fullTitle = title === 'EviTale' ? title : `${title} · EviTale`;
const site = Astro.site;
const ogImage = site && image ? new URL(image, site).href : undefined;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
---

<!doctype html>
<html lang="lt" data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f7f5f0" id="theme-color" />
    <script is:inline>
      // Prieš piešiant puslapį: režimas ir raidžių dydis. Čia tik skaitoma, įrašoma tik paspaudus mygtuką.
      (function () {
        var d = document.documentElement;
        try {
          var theme = localStorage.getItem('evitale-theme');
          if (theme !== 'night' && theme !== 'day') {
            var h = new Date().getHours();
            theme = h >= 20 || h < 7 ? 'night' : 'day';
          }
          d.dataset.theme = theme;
          document.getElementById('theme-color').content = theme === 'night' ? '#1c1f2b' : '#f7f5f0';
          var scale = parseFloat(localStorage.getItem('evitale-text') || '');
          if (scale >= 0.8 && scale <= 1.6) d.style.setProperty('--read-scale', String(scale));
          // Senas skaitymo pasirinkimas nebereikalingas.
          localStorage.removeItem('evitale-layer');
        } catch (e) {
          /* privatus langas: lieka dienos režimas ir numatytas dydis */
        }
        // Seni adresai su ?layer=... veda į tą patį puslapį, tik be šio priedo.
        try {
          var u = new URL(location.href);
          if (u.searchParams.has('layer')) {
            u.searchParams.delete('layer');
            history.replaceState(null, '', u.pathname + u.search + u.hash);
          }
        } catch (e) {
          /* sena naršyklė */
        }
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EviTale" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="lt_LT" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
  </head>
  <body>
    <a class="skip" href="#turinys">Pereiti prie turinio</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <svg class="logo-mark" width="30" height="30" viewBox="6 6 22 22" aria-hidden="true">
            <path d="M8.5 16.5H23.5C23.5 11.5 20.2 8 16 8C11.4 8 8 11.6 8 16.3C8 21.2 11.5 24.5 16.2 24.5C19.4 24.5 21.6 23 23 21.2C24.4 19.6 25.6 20.4 26.4 22.6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          EviTale
        </a>
        <nav class="site-nav" aria-label="Pagrindinis meniu">
          <a href="/#lentyna" class="hide-s">{UI.shelf}</a>
          <a href="/#apie" class="hide-s">{UI.aboutTitle}</a>
          <a href="/#kontaktai" class="hide-s">Kontaktai</a>
          <button type="button" class="theme-toggle" data-theme-toggle data-label-night={UI.themeToNight} data-label-day={UI.themeToDay}>
            <span class="when-day">{UI.night}</span><span class="when-night">{UI.day}</span>
          </button>
        </nav>
      </div>
    </header>

    <div id="turinys">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <span><b>EviTale</b> · pasakos tau</span>
        <span>{UI.privacyNote}</span>
      </div>
    </footer>
  </body>
</html>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.getElementById('theme-color') as HTMLMetaElement | null;

  function applyTheme(theme: 'night' | 'day') {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'night' ? '#1c1f2b' : '#f7f5f0';
    if (toggle) toggle.setAttribute('aria-label', (theme === 'night' ? toggle.dataset.labelDay : toggle.dataset.labelNight) ?? '');
  }

  applyTheme(root.dataset.theme === 'night' ? 'night' : 'day');

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'night' ? 'day' : 'night';
    applyTheme(next);
    try {
      localStorage.setItem('evitale-theme', next);
    } catch {
      /* saugykla išjungta */
    }
  });
</script>
