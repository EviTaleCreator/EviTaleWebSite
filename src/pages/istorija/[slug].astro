---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stories = await Astro.glob('../../content/stories/*.md');
  return stories.map(story => ({
    params: { slug: story.frontmatter.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = story;
---

<BaseLayout title={story.frontmatter.title}>
  <!-- Viršutinė navigacija su grįžimu į vieno puslapio skiltis -->
  <header class="border-b border-[#E8E1D5] bg-[#FAF7F2]/95 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/#lentyna" class="font-sans text-xs uppercase tracking-widest text-[#7A736E] hover:text-[#D96B43] flex items-center gap-1.5 transition-colors">
        <span>&larr;</span>
        <span>Atgal į lentyną</span>
      </a>
      <a href="/" class="font-cinzel text-xl font-bold text-[#1D2520]">EviTale</a>
      <div class="w-16"></div>
    </div>
  </header>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <header class="text-center mb-10">
      <div class="font-sans text-xs uppercase tracking-widest text-[#7A736E] mb-3">
        {story.frontmatter.date} &bull; EviTale istorija
      </div>
      <h1 class="text-3xl sm:text-5xl font-cinzel text-[#1D2520] mb-8 leading-tight">
        {story.frontmatter.title}
      </h1>

      <!-- Interaktyvus amžiaus perjungiklis (A variantas - persijungia vietoje be lango krovimo) -->
      <div class="inline-flex flex-wrap justify-center p-1 bg-[#EFE9DF] rounded-full border border-[#DED7CB] font-sans text-xs sm:text-sm shadow-inner" id="age-switcher">
        <button data-target="age-2-4" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">2–4 m.</button>
        <button data-target="age-5-8" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">5–8 m.</button>
        <button data-target="age-9-12" class="age-btn active-btn px-4 py-1.5 rounded-full bg-[#1D2520] text-[#FAF7F2] font-semibold transition-all shadow-sm">9–12 m.</button>
        <button data-target="age-vyresniems" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">Vyresniems</button>
      </div>
    </header>

    <!-- Viršelio iliustracija -->
    {story.frontmatter.coverImage && (
      <div class="mb-12 rounded-2xl overflow-hidden border border-[#E8E1D5] shadow-sm">
        <img src={story.frontmatter.coverImage} alt={story.frontmatter.title} class="w-full h-72 sm:h-96 object-cover" />
      </div>
    )}

    <!-- Pasakos turinys iš .md -->
    <div id="story-container" class="story-text max-w-none text-[#2C2825] leading-relaxed">
      <Content />
    </div>

    <!-- Pabaiga su nuoroda atgal -->
    <div class="mt-16 pt-8 border-t border-[#E8E1D5] flex flex-col sm:flex-row justify-between items-center font-sans text-sm gap-4">
      <a href="/#lentyna" class="text-[#D96B43] hover:underline font-medium">&larr; Pasirinkti kitą pasaką</a>
      <a href="/#kontaktai" class="text-[#7A736E] hover:text-[#1D2520]">Parašyti autorei</a>
    </div>
  </article>

  <footer class="border-t border-[#E8E1D5] bg-[#EFE9DF] py-8 font-sans text-xs text-[#7A736E] text-center">
    <p class="font-cinzel text-sm text-[#1D2520]">EviTale Creator</p>
  </footer>
</BaseLayout>

<style is:global>
  .story-text :where(p, ul, ol, blockquote, pre) { margin-block: 1em; }
  .story-text :where(h2, h3, h4) { font-weight: 600; line-height: 1.3; margin-block: 1.5em 0.75em; }
  .story-text h2 { font-size: 1.5em; }
  .story-text h3 { font-size: 1.25em; }
  .story-text ul { list-style-type: disc; padding-left: 1.5em; }
  .story-text ol { list-style-type: decimal; padding-left: 1.5em; }
  .story-text li + li { margin-top: 0.4em; }
  .story-text blockquote { border-left: 3px solid #D96B43; padding-left: 1em; font-style: italic; }
  .story-text a { color: #A64625; text-decoration: underline; }
  .story-text img { max-width: 100%; height: auto; border-radius: 1rem; margin-block: 1.5em; }
  .story-text pre { overflow-x: auto; padding: 1em; background: #F4EFE6; }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll('.age-btn'));
  const sections = Array.from(document.querySelectorAll('#story-container [data-age]'));
  const available = sections.map(section => section.getAttribute('data-age'));
  const fallback = available.includes('age-9-12') ? 'age-9-12' : available[0];

  function selectAge(requested) {
    const target = available.includes('age-' + requested) ? 'age-' + requested : fallback;
    if (!target) return;
    sections.forEach(section => section.classList.toggle('hidden', section.getAttribute('data-age') !== target));
    buttons.forEach(button => {
      const active = button.getAttribute('data-target') === target;
      const exists = available.includes(button.getAttribute('data-target'));
      button.toggleAttribute('disabled', !exists);
      button.classList.toggle('hidden', !exists);
      ['bg-[#1D2520]', 'text-[#FAF7F2]', 'font-semibold', 'shadow-sm', 'active-btn'].forEach(c => button.classList.toggle(c, active));
      button.classList.toggle('text-[#666059]', !active);
      button.setAttribute('aria-pressed', String(active));
    });
    const age = target.replace('age-', '');
    const url = new URL(window.location.href);
    url.searchParams.set('age', age);
    window.history.replaceState(null, '', url);
    document.querySelectorAll('a[href*="#lentyna"]').forEach(link => {
      link.setAttribute('href', '/?age=' + encodeURIComponent(age) + '#lentyna');
    });
  }

  buttons.forEach(button => button.addEventListener('click', () => {
    selectAge((button.getAttribute('data-target') || '').replace('age-', ''));
  }));
  const restoreAge = () => selectAge(new URLSearchParams(window.location.search).get('age'));
  restoreAge();
  window.addEventListener('pageshow', restoreAge);
  window.addEventListener('popstate', restoreAge);
</script>
