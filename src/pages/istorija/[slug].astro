---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const stories = await Astro.glob('../../content/stories/*.md');
  return stories.map(story => ({
    params: { slug: story.frontmatter.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = story;
---

<BaseLayout title={story.frontmatter.title}>
  <Header slot="header" />

  <article class="max-w-3xl mx-auto px-4 py-10 md:py-16">
    <!-- Antraštė -->
    <header class="text-center mb-10">
      <div class="inline-flex items-center space-x-2 font-sans text-xs uppercase tracking-widest text-[#7A736E] mb-3">
        <span>{story.frontmatter.date}</span>
        <span>•</span>
        <span>EviTale</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-cinzel text-[#1D2520] mb-8 leading-tight">
        {story.frontmatter.title}
      </h1>

      <!-- Interaktyvus amžiaus perjungiklis (A variantas) -->
      <div class="inline-flex p-1 bg-[#EFE9DF] rounded-full border border-[#DED7CB] font-sans text-xs md:text-sm shadow-inner" id="age-switcher">
        <button data-target="age-2-4" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">2–4 m.</button>
        <button data-target="age-5-8" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">5–8 m.</button>
        <button data-target="age-9-12" class="age-btn px-4 py-1.5 rounded-full bg-[#1D2520] text-[#FAF7F2] font-semibold transition-all shadow-sm">9–12 m.</button>
        <button data-target="age-vyresniems" class="age-btn px-4 py-1.5 rounded-full text-[#666059] transition-all">Vyresniems</button>
      </div>
    </header>

    <!-- Viršelio iliustracija -->
    {story.frontmatter.coverImage && (
      <div class="mb-12 rounded-2xl overflow-hidden border border-[#E8E1D5] shadow-sm">
        <img src={story.frontmatter.coverImage} alt={story.frontmatter.title} class="w-full h-72 md:h-96 object-cover" />
      </div>
    )}

    <!-- Pasakos turinys iš .md -->
    <div id="story-container" class="prose prose-lg max-w-none text-[#2C2825] leading-relaxed">
      <Content />
    </div>

    <!-- Grįžti į lentyną -->
    <div class="mt-16 pt-8 border-t border-[#E8E1D5] flex justify-between items-center font-sans text-sm">
      <a href="/lentyna" class="text-[#D96B43] hover:underline">&larr; Atgal į pasakų lentyną</a>
      <span class="text-[#7A736E]">EviTale Creator</span>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Kliento pusės logika: amžiaus perjungiklis
  const buttons = document.querySelectorAll('.age-btn');
  const container = document.getElementById('story-container');

  function updateVisibleAge(targetAge: string) {
    // Rasti visas amžiaus sekcijas
    const allSections = container?.querySelectorAll('[data-age]');
    allSections?.forEach(sec => {
      if (sec.getAttribute('data-age') === targetAge) {
        sec.classList.remove('hidden');
      } else {
        sec.classList.add('hidden');
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target') || 'age-9-12';

      buttons.forEach(b => {
        b.classList.remove('bg-[#1D2520]', 'text-[#FAF7F2]', 'font-semibold', 'shadow-sm');
        b.classList.add('text-[#666059]');
      });

      btn.classList.add('bg-[#1D2520]', 'text-[#FAF7F2]', 'font-semibold', 'shadow-sm');
      btn.classList.remove('text-[#666059]');

      updateVisibleAge(target);
    });
  });

  // Pradinis nustatymas: 9-12 m.
  updateVisibleAge('age-9-12');
</script>
