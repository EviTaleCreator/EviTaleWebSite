---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Kontaktai">
  <Header slot="header" />

  <section class="max-w-2xl mx-auto px-4 py-16 text-center">
    <p class="font-sans text-xs uppercase tracking-widest text-[#7A736E] mb-2">Grįžtamasis ryšys</p>
    <h1 class="font-cinzel text-4xl text-[#1D2520] mb-6">Kontaktai</h1>
    <p class="font-sans text-[#666059] mb-10 leading-relaxed">
      Turite minčių, norite pasiūlyti temą pasakai ar pasidalinti savo šeimos įspūdžiais? Parašykite man.
    </p>

    <div class="bg-[#FAF7F2] p-8 rounded-2xl border border-[#E8E1D5] shadow-sm text-left font-sans text-sm">
      <div class="mb-4">
        <label class="block text-xs uppercase tracking-wider text-[#7A736E] mb-2">El. paštas</label>
        <p class="text-base text-[#1D2520] font-medium font-serif">labas@evitale.lt</p>
      </div>
      <div class="pt-4 border-t border-[#E8E1D5]">
        <label class="block text-xs uppercase tracking-wider text-[#7A736E] mb-2">Socialiniai tinklai</label>
        <p class="text-[#666059]">Instagram: <span class="text-[#D96B43]">@evitale_creator</span></p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
