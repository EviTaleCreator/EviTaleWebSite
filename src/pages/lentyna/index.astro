---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allStories = await Astro.glob('../../content/stories/*.md');
const sortedStories = allStories.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout title="Pasakų lentyna">
  <Header slot="header" />

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="font-sans text-xs uppercase tracking-widest text-[#7A736E] mb-2">Visos istorijos</p>
      <h1 class="font-cinzel text-4xl text-[#1D2520] mb-4">Pasakų lentyna</h1>
      <p class="font-sans text-[#666059] text-sm">
        Rinkitės pasaką pagal dominančią temą ar amžiaus grupę. Kiekviena istorija turi pritaikytas versijas.
      </p>
    </div>

    <!-- Istorijų kortelių tinklelis -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {sortedStories.map((story) => (
        <a href={`/istorija/${story.frontmatter.slug}`} class="group bg-[#FAF7F2] border border-[#E8E1D5] rounded-2xl overflow-hidden hover:shadow-lg transition-all flex flex-col">
          <div class="h-56 bg-[#EBE4D8] overflow-hidden">
            <img src={story.frontmatter.coverImage || "/hero-banner.jpg"} alt={story.frontmatter.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <p class="font-sans text-xs uppercase tracking-wider text-[#7A736E] mb-2">{story.frontmatter.date}</p>
            <h3 class="font-cinzel text-xl text-[#1D2520] group-hover:text-[#D96B43] transition-colors mb-3">
              {story.frontmatter.title}
            </h3>
            <p class="text-sm font-sans text-[#666059] line-clamp-3 mb-6 flex-grow">
              {story.frontmatter.excerpt}
            </p>
            <div class="flex items-center gap-1.5 flex-wrap pt-4 border-t border-[#E8E1D5]/60">
              {story.frontmatter.hasAges?.map((age: string) => (
                <span class="font-sans text-[11px] px-2.5 py-0.5 rounded-full bg-[#EFE9DF] text-[#4A4540]">
                  {age === 'vyresniems' ? 'Vyresniems' : `${age} m.`}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
